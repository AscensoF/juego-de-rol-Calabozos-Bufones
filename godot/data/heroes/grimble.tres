hero_name = "Grimble el Pícaro Bocazas"
hero_class = 2
lore_history = "Grimble era un carterista hasta que la Pifia le concedió la habilidad de robar conceptos abstractos. Su gran golpe fue sustraer el 'sentido de la orientación' a un minotauro. Ahora busca el botín definitivo: el 'sentido común' que perdieron los dioses."
lore_attributes = "DESTREZA increíble para el sigilo y para gesticular mientras farda de sus robos. CARISMA magnético aunque sospechoso."
