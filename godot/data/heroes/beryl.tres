[resource]
script = ExtResource("1_hero")
id = "hero_beryl"
hero_name = "Sister Beryl la Clérigo Irreverente"
hero_class = 3
lore_history = "Beryl regentaba una cervecería monástica. Durante la Pifia, rezó para que los barriles no se agriaran y una deidad menor del buen beber y las peleas de taberna respondió. Ahora canaliza poder divino a través de su martillo y su fiel gallina de combate, Clotilde."
lore_attributes = "SABIDURÍA para elaborar la mejor cerveza sagrada. FUERZA para expulsar parroquianos violentos. Fe inquebrantable."
